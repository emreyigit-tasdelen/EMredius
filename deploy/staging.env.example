# /etc/emredius/staging.env — staging instance (never points at live data)
DB_NAME=radius_staging
# own DB user with rights on radius_staging only (see docs/STAGING_KURULUM.md step 5);
# the password line is appended on the server, never committed
DB_USER=emredius_stage
NMS_DB_PATH=/opt/emredius_stage/nms/data/enterprise_nms.db
# 5651 archive: never the live default /var/lib/emredius/5651 (same value as the systemd drop-in paths.conf;
# needed here too so manual `maintenance.py archive5651` runs with this env file stay out of the live chain)
ARCHIVE_5651_DIR=/opt/emredius_stage/var/5651
SECRET_KEY_FILE=/etc/emredius/staging_secret_key
SESSION_COOKIE_NAME=emredius_stage
# staging is reached through an SSH tunnel over plain http
SESSION_COOKIE_SECURE=0
START_BACKGROUND_JOBS=1
# never restart/stop live services or change firewall/clock from staging
SYSTEM_DRY_RUN=1
LOG_LEVEL=INFO
