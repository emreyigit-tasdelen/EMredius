[Unit]
Description=EMredius panel (STAGING, gunicorn 127.0.0.1:5100)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
# own venv: staging packages never touch the system python3.12 the live panel uses
Type=simple
User=root
WorkingDirectory=/opt/emredius_stage
Environment=EMREDIUS_ENV_FILE=/etc/emredius/staging.env
Environment=EMREDIUS_BIND=127.0.0.1:5100
Environment=EMREDIUS_PROC_NAME=emredius-staging
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/emredius_stage/.venv/bin/python -m gunicorn -c /opt/emredius_stage/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full

[Install]
WantedBy=multi-user.target
