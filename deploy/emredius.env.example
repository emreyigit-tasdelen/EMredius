# /etc/emredius/emredius.env — live panel (chmod 600). No password here: the DB password is read from
# FreeRADIUS' /etc/raddb/mods-enabled/sql (single source of truth).
DB_NAME=radius
DB_USER=radius
# Shared with emredius-nms.service (Environment=NMS_DB_PATH); change both together.
NMS_DB_PATH=/opt/emredius/nms/data/enterprise_nms.db
# 5651 signed archive (live default). Staging MUST set its own: ARCHIVE_5651_DIR=/opt/emredius_stage/var/5651
# (see staging.env.example) or it would write into this chain.
#ARCHIVE_5651_DIR=/var/lib/emredius/5651
MYSQL_DEFAULTS_FILE=/etc/emredius/my.cnf
PANEL_UNIT=emredius-panel.service
SYSTEM_DRY_RUN=0
LOG_LEVEL=INFO
